// Generated by CMake from lsan_suppressions.txt / tsan_suppressions.txt.
// Do not edit the generated copy -- edit those files instead.
//
// The sanitizer runtimes call these weak hooks at startup, which means the
// suppressions travel inside the binary. That is deliberate:
//
//   1. LSAN_OPTIONS/TSAN_OPTIONS are parsed as `key=value:key=value`, so a
//      suppressions path containing a space is a hard parse error with no
//      escaping mechanism. This repo lives under ".../Computer Science/loom".
//   2. Nobody has to remember to export anything -- CI, Docker, and a developer
//      running the binary by hand all get identical behaviour.
//
// An explicit LSAN_OPTIONS/TSAN_OPTIONS=suppressions=... still overrides these
// if you need to widen or narrow them for a one-off investigation.

extern "C" const char* __lsan_default_suppressions();
extern "C" const char* __tsan_default_suppressions();

extern "C" const char* __lsan_default_suppressions() {
  return "@LOOM_LSAN_SUPPRESSIONS@";
}

extern "C" const char* __tsan_default_suppressions() {
  return "@LOOM_TSAN_SUPPRESSIONS@";
}
